# LLM Provider Configuration

# Default LLM Provider (optional, defaults to OPENAI)
# Determines which {PROVIDER}_API_KEY, {PROVIDER}_BASE_URL, {PROVIDER}_MODEL to use
# Examples: OPENAI, DEEPSEEK, GEMINI, ANTHROPIC
# LLM_PROVIDER=OPENAI

# API Key (required)
OPENAI_API_KEY=your-api-key-here

# Base URL (REQUIRED — startup fails with ValueError if not set)
# For OpenAI: https://api.openai.com/v1
# For other providers: use their base URL
OPENAI_BASE_URL=https://api.openai.com/v1

# Model (REQUIRED — startup fails with ValueError if not set)
# For OpenAI: gpt-5.4, gpt-4.1, etc.
# For Claude via OpenAI-compatible endpoint: claude-sonnet-4-6, claude-opus-4-6, etc.
OPENAI_MODEL=gpt-5.4

# Wire protocol for this provider block (optional, default openai-completions).
# Set on the block it describes — {PROVIDER}_API_FORMAT — and never inferred
# from the base URL, the provider name or the model name. Values:
#   openai-completions   OpenAI Chat Completions (any OpenAI-compatible endpoint)
#   anthropic-messages   Anthropic's Messages API (official SDK, installed with agentao)
# An unknown value fails at startup. /provider reads the target block's value,
# so a switch between blocks on different protocols changes the wire with it.
#
# Native Anthropic (base URL is the API root, no /v1; LLM_TEMPERATURE is not
# sent on this wire; extended thinking goes through LLM_EXTRA_BODY):
# LLM_PROVIDER=ANTHROPIC
# ANTHROPIC_API_KEY=your-api-key-here
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_API_FORMAT=anthropic-messages
# LLM_MAX_TOKENS=32000
# LLM_EXTRA_BODY={"thinking": {"type": "enabled", "budget_tokens": 8000}}

# LLM Temperature (0.0-2.0, default: 0.2, lower = more deterministic)
# LLM_TEMPERATURE=0.2

# Explicit prompt-cache breakpoints (optional, default off).
# For an endpoint that honours Anthropic-style cache_control over the ordinary
# Chat Completions wire, this marks at most 3 breakpoints per agent-turn
# request (system message, last tool definition, end of stable history) and
# leaves the 4th slot for the endpoint's own automatic caching.
# Off by default on purpose: agentao verified that the OpenAI SDK forwards the
# key unchanged, NOT that your gateway honours it — verify your endpoint first.
# An unrecognised value fails at startup.
# LLM_PROMPT_CACHE=anthropic
# LLM_PROMPT_CACHE_TTL=1h

# ─── Web Search ─────────────────────────────────────────────────────────────
# web_search runs an ordered fallback chain, retreating to the next backend
# whenever one errors (an empty "no results" answer is NOT a failure):
#       jina (if JINA_API_KEY)  →  bocha (if BOCHA_API_KEY)  →  duckduckgo
# DuckDuckGo is keyless and always the last resort. Pinning
# WebSearchTool(backend="...") disables the fallback.
#
# >>> Set at least one key. <<< Both keyless paths are unreliable as of
# 2026-07-22: s.jina.ai returns 401 without a key, and html.duckduckgo.com
# frequently answers a bot-challenge page instead of results (web_search
# reports that as an error, not as "no results"). With no key at all the chain
# is duckduckgo alone, so search fails whenever that challenge fires.
#
# Bocha — higher-quality structured results. Get a key at https://bochaai.com
# BOCHA_API_KEY=your-bocha-key-here
#
# Jina (s.jina.ai) — requires a key (the endpoint used to be keyless; it now
# answers 401 without one). Get a key at https://jina.ai
# JINA_API_KEY=your-jina-key-here

# ─── Web Fetch (JS-rendering fallback) ──────────────────────────────────────
# web_fetch uses a direct httpx GET by default. When a page requires JS
# rendering or the direct fetch fails, set this to opt in to a fallback:
#   jina      — sends the URL to https://r.jina.ai (third-party service);
#               disclosed in the tool description and result audit line.
#   playwright — local headless Chromium; the URL never leaves the machine.
#                Requires BOTH:
#                  pip install 'agentao[playwright]'
#                  playwright install chromium
#                (Renamed from "crawl4ai" in 0.4.18. The old value still
#                 works, maps here, and logs a warning.)
#   none      — (default) no fallback; on a JS-detected page the tool
#               returns the static shell with a warning Note.
# AGENTAO_WEB_FETCH_FALLBACK=none

# Optional: higher rate limits when AGENTAO_WEB_FETCH_FALLBACK=jina
# JINA_API_KEY=your-jina-key-here

# ─── Web Fetch (SSRF allowlist) ─────────────────────────────────────────────
# web_fetch rejects any URL that resolves to a non-public address (loopback /
# private / link-local / cloud-metadata) — the SSRF guard. If you run behind a
# fake-IP proxy (Clash / V2Ray / Surge map every domain to a reserved range,
# typically 198.18.0.0/15), public sites resolve to those reserved IPs and get
# blocked. Opt specific CIDRs (or bare IPs) back in here — comma/space
# separated. This RELAXES an SSRF control (logged once at startup); keep it as
# narrow as possible and never add 0.0.0.0/0. Default empty = fully strict.
# Cleaner alternative: switch the proxy DNS from fake-ip to redir-host/real-ip.
# AGENTAO_WEB_FETCH_ALLOW_CIDRS=198.18.0.0/15
